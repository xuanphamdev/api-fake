datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id             String                @id @default(uuid())
  name           String
  slug           String                @unique
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoints      Endpoint[]
  secrets        ProjectSecret[]
  collaborators  ProjectCollaborator[]
  apiKeys        ApiKey[]
  corsOrigins    String?
  corsHeaders    String?
  corsMethods    String?
  corsCredentials Boolean              @default(false)
  enforceApiKey  Boolean               @default(false)
  webhookUrl     String?
  createdAt      DateTime              @default(now())
}

model ProjectSecret {
  id             String   @id @default(uuid())
  key            String
  encryptedValue String
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([projectId, key])
}

model ProjectCollaborator {
  id        String   @id @default(uuid())
  email     String
  role      String   // "READ" | "WRITE"
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, email])
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Endpoint {
  id           String    @id @default(uuid())
  path         String
  method       String
  headers      Json?
  statusCode   Int       @default(200)
  responseBody String?
  delay        Int       @default(0)
  script       String?
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs         ApiLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([projectId, path, method])
}

model ApiLog {
  id          String    @id @default(uuid())
  endpointId  String
  endpoint    Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  method      String
  path        String
  reqHeaders  Json
  reqQuery    Json
  reqBody     Json?
  resHeaders  Json
  resStatus   Int
  resBody     String?
  duration    Int
  timestamp   DateTime  @default(now())

  @@index([timestamp, resStatus])
}
