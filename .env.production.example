# Production environment for docker-compose on the VPS.
# Copy to `.env` on the server and fill in strong secrets. Never commit the real .env.

# --- Domain / TLS ---
# Real hostname (DNS A record must point to this VPS) enables automatic HTTPS via Caddy.
DOMAIN="apifake.example.com"

# --- Database ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_strong_db_password"
POSTGRES_DB="apifake"
# Must use the same user/password/db as above; host is the compose service name `db`.
DATABASE_URL="postgresql://postgres:CHANGE_ME_strong_db_password@db:5432/apifake?schema=public"

# --- Application secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_random_64_hex"
# EXACTLY 32 characters. Shared by dashboard (encrypt) and gateway (decrypt) — must match.
# Changing this after secrets are stored makes existing encrypted secrets undecryptable.
ENCRYPTION_KEY="CHANGE_ME_exactly_32_characters!"
